# Copiez ce fichier en ".env" puis remplissez vos clés.
# Clé API TMDB : https://www.themoviedb.org/settings/api
TMDB_API_KEY=ta_cle_api_tmdb

# Domaine / origine custom du site (ex: https://movix.online)
PUBLIC_ORIGIN=https://movix.online

# Port d'écoute
PORT=3002

# Optionnel : si vide, une clé JWT est générée et stockée dans server/data/.secret
JWT_SECRET=

# Forcer la connexion pour regarder du contenu (téléchargement + lecture)
REQUIRE_AUTH_TO_WATCH=true

# Approbation des nouveaux comptes par un administrateur avant connexion
# (créez un admin avec : npm --prefix server run add-admin)
REQUIRE_ADMIN_APPROVAL=true

# Serveur agrégateur de sources vidéo (streaming player aggregation).
# C'est aussi la base de l'API cinejoy (même adresse).
# Test local : http://localhost:3001 — Prod : http://IP_OU_SERVICE:3000
AGGREGATE_URL=http://localhost:3001

# Dossier où sont téléchargées les vidéos en local (relatif au projet ou chemin absolu)
DOWNLOAD_DIR=./downloads

# Fallback yt-dlp : essayé uniquement quand aucune source trouvée (directe ou scrapée)
YTDLP_FALLBACK=true
# Binaire yt-dlp à utiliser (par défaut "yt-dlp", doit être dans le PATH)
# YTDLP_BIN=/usr/local/bin/yt-dlp
# Temps max d'un essai yt-dlp en ms (défaut 180000)
# YTDLP_TIMEOUT=180000

# Durée minimale (en secondes) d'une source pour être acceptée.
# En dessous (intros ~18s), la source est rejetée et on essaie la suivante.
MIN_SOURCE_SECONDS=60

# Hosts de sources à exclure (séparés par des virgules).
# Certains ne servent qu'une intro de quelques secondes au lieu du film.
DOWNLOAD_EXCLUDE_SOURCES=firestream.to,firestream.top
