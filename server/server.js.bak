import 'dotenv/config'
import express from 'express'
import cors from 'cors'
import { dirname, join } from 'path'
import { fileURLToPath } from 'url'
import { register, login, signToken, toPublic, updateSettings, approveUser, deleteUser, listUsers, getConfig, setConfig, approvalRequired } from './lib/users.js'
import { requireAuth, requireAdmin } from './lib/auth.js'
import { rateLimit } from './lib/ratelimit.js'
import {
  ApiError,
  getDiscover,
  getTitle,
  getSeasonEpisodes,
  searchTMDB,
} from './lib/tmdb.js'
import {
  AGGREGATE_URL,
  DOWNLOAD_DIR,
  getStatus,
  pathKey,
  startDownload,
  targetHeight,
  readdirSafe,
  runFfmpeg,
  folderFor,
} from './lib/downloader.js'

const ROOT = dirname(dirname(fileURLToPath(import.meta.url)))
const CLIENT_DIR = join(ROOT, 'client')
const PORT = Number(process.env.PORT || 3002)
const PUBLIC_ORIGIN = process.env.PUBLIC_ORIGIN || ''
const REQUIRE_AUTH_TO_WATCH = process.env.REQUIRE_AUTH_TO_WATCH !== 'false'

const authGate = REQUIRE_AUTH_TO_WATCH ? requireAuth : (req, res, next) => next()

const app = express()
app.use(cors({ origin: PUBLIC_ORIGIN || true }))
app.use(express.json({ limit: '1mb' }))

const wrap = (fn) => (req, res, next) => fn(req, res, next).catch(next)

app.get('/api/health', (req, res) => {
  res.json({ ok: true, name: 'Lumo', origin: PUBLIC_ORIGIN || 'localhost', requireAuthToWatch: REQUIRE_AUTH_TO_WATCH })
})

app.get('/api/config', (req, res) => {
  res.json({ requireAuthToWatch: REQUIRE_AUTH_TO_WATCH, allowRegistration: getConfig().allowRegistration })
})

// --- Auth ---------------------------------------------------------------
const authLimit = rateLimit({ maxPerIdentity: 10, maxGlobal: 100 })

app.post('/api/auth/register', authLimit, wrap(async (req, res) => {
  const { username, password } = req.body || {}
  const user = await register(username, password)
  if (approvalRequired()) {
    return res.status(201).json({ user: toPublic(user), pending: true, message: 'Compte créé. Un administrateur doit valider votre inscription avant de pouvoir vous connecter.' })
  }
  res.status(201).json({ token: signToken(user), user: toPublic(user) })
}))

app.post('/api/auth/login', authLimit, wrap(async (req, res) => {
  const { username, password } = req.body || {}
  const user = await login(username, password)
  if (!user) return res.status(401).json({ error: 'Pseudo ou mot de passe incorrect.' })
  if (user.status === 'pending') {
    return res.status(403).json({ error: "Votre compte est en attente d'approbation par un administrateur." })
  }
  res.json({ token: signToken(user), user: toPublic(user) })
}))

app.get('/api/auth/me', requireAuth, (req, res) => {
  res.json({ user: toPublic(req.user) })
})

app.put('/api/me/settings', requireAuth, wrap(async (req, res) => {
  const user = await updateSettings(req.user.id, req.body || {})
  res.json({ user })
}))

// --- Administration (réservée aux admins) ----------------------------------
app.get('/api/admin/users', requireAdmin, wrap(async (req, res) => {
  res.json({ users: listUsers() })
}))

app.get('/api/admin/settings', requireAdmin, async (req, res) => {
  res.json(getConfig())
})

app.put('/api/admin/settings', requireAdmin, async (req, res) => {
  res.json(await setConfig(req.body || {}))
})

app.post('/api/admin/users/:id/approve', requireAdmin, wrap(async (req, res) => {
  const id = String(req.params.id)
  const user = await approveUser(id)
  if (!user) return res.status(404).json({ error: 'Utilisateur introuvable.' })
  res.json({ user })
}))

app.delete('/api/admin/users/:id', requireAdmin, wrap(async (req, res) => {
  const id = String(req.params.id)
  const out = await deleteUser(id, req.user.id)
  if (!out) return res.status(404).json({ error: 'Utilisateur introuvable.' })
  res.json({ ok: true })
}))

// --- TMDB (clé cachée côté serveur) --------------------------------------
app.get('/api/discover', wrap(async (req, res) => {
  const region = String(req.query.region || 'FR').toUpperCase().slice(0, 2)
  res.json(await getDiscover(region))
}))

app.get('/api/search', wrap(async (req, res) => {
  const region = String(req.query.region || 'FR').toUpperCase().slice(0, 2)
  const q = String(req.query.q || '').trim()
  res.json(await searchTMDB(q, region))
}))

app.get('/api/title/:type/:id', wrap(async (req, res) => {
  const { type, id } = req.params
  if (!['movie', 'tv'].includes(type)) throw new ApiError(400, 'Type invalide.')
  const region = String(req.query.region || 'FR').toUpperCase().slice(0, 2)
  res.json(await getTitle(type, Number(id), region))
}))

app.get('/api/title/tv/:id/season/:season', wrap(async (req, res) => {
  const { id, season } = req.params
  res.json({ episodes: await getSeasonEpisodes(Number(id), Number(season)) })
}))

app.post('/api/dl/:type/:id', authGate, wrap(async (req, res) => {
  const { type, id } = req.params
  const { season, episode, quality } = req.query
  res.json(await startDownload(type, String(id), Number(season) || 1, Number(episode) || 1, quality))
}))

app.get('/api/dl/:type/:id', authGate, wrap(async (req, res) => {
  const { type, id } = req.params
  const { season, episode, quality } = req.query
  const key = pathKey(type, String(id), Number(season) || 1, Number(episode) || 1, quality)
  res.json(await getStatus(key))
}))

// --- Frontend statique ----------------------------------------------------
app.use(express.static(CLIENT_DIR))

// Dossier de téléchargements : servi en local pour la lecture
app.use('/dl', express.static(DOWNLOAD_DIR, {
  setHeaders(res, filePath) {
    if (filePath.endsWith('.m3u8')) res.setHeader('Content-Type', 'application/vnd.apple.mpegurl')
    if (filePath.endsWith('.ts')) res.setHeader('Content-Type', 'video/mp2t')
    res.setHeader('Cache-Control', 'public, max-age=31536000, immutable')
  },
}))

app.get(/^\/(?!api\/).*/, (req, res) => {
  res.sendFile(join(CLIENT_DIR, 'index.html'))
})

// --- Gestion des erreurs ---------------------------------------------------
app.use((err, req, res, next) => {
  if (err instanceof ApiError) return res.status(err.status).json({ error: err.message })
  if (err.status) return res.status(err.status).json({ error: err.message })
  console.error(err)
  res.status(500).json({ error: 'Erreur serveur interne.' })
})

app.listen(PORT, () => {
  console.log(`Lumo backend sur http://localhost:${PORT}${PUBLIC_ORIGIN ? ` (origine: ${PUBLIC_ORIGIN})` : ''}`)
})
